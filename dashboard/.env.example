# Copy this file to dashboard/.env and replace the two passwords.
#   cd dashboard
#   cp .env.example .env        (Windows: copy .env.example .env)
# .env is git-ignored: never commit a real password.
#
# These are values for the throwaway MySQL container started by docker-compose.yml,
# not credentials for any real system.

MYSQL_ROOT_PASSWORD=changeme-root
DASHBOARD_DB_PASSWORD=changeme-bike

# Shared by docker-compose.yml, api/main.py and spark/streaming_consumer.py
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=bike
MYSQL_PASSWORD=changeme-bike
MYSQL_DATABASE=bike_db
